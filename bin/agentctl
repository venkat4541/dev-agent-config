#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_parent="$(cd "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" != /* ]] && script_path="$script_parent/$script_path"
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  agentctl doctor
  agentctl check
  agentctl sync
  agentctl unsync
  agentctl review-models [--apply]
  agentctl start-task <task-name> [base-branch]
  agentctl init-existing [path]
  agentctl init-next <project-name>
EOF
}

require_clean_git() {
  local action="${1:-continue}"
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "Refusing to $action in a dirty repository. Commit, stash, or review changes first." >&2
    exit 1
  fi
}

detect_package_manager() {
  if [[ -f pnpm-lock.yaml ]]; then echo pnpm
  elif [[ -f yarn.lock ]]; then echo yarn
  elif [[ -f bun.lockb || -f bun.lock ]]; then echo bun
  elif [[ -f package-lock.json ]]; then echo npm
  else echo unknown
  fi
}

start_task() {
  local task_name="${1:-}" base_branch="${2:-main}" project_root projects_json project_id
  local branch_name

  [[ -n "$task_name" && "$task_name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || {
    echo "Provide a lowercase kebab-case task name, for example: account-notifications." >&2
    exit 1
  }
  command -v superset >/dev/null 2>&1 || { echo "Superset is required; run agentctl doctor." >&2; exit 1; }
  command -v jq >/dev/null 2>&1 || { echo "jq is required; run ./scripts/install-tools.sh." >&2; exit 1; }
  git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "Run this inside a Git repository." >&2; exit 1; }

  project_root="$(git rev-parse --show-toplevel)"
  cd "$project_root"
  require_clean_git "create a task worktree"
  # A missing base branch must reach the explanatory error below, not abort
  # here with git's raw fetch failure under `set -e`.
  git fetch origin "$base_branch" 2>/dev/null || true
  git rev-parse --verify --quiet "refs/remotes/origin/$base_branch" >/dev/null || {
    echo "Base branch is not available on origin: $base_branch. Push it first." >&2
    exit 1
  }

  projects_json="$(superset projects list --local --json)"
  project_id="$(jq -r --arg path "$project_root" '.[] | select(.path == $path) | .id' <<<"$projects_json" | head -1)"
  if [[ -z "$project_id" || "$project_id" == "null" ]]; then
    echo "Registering this repository with Superset on this Mac..."
    superset projects create --local --name "$(basename "$project_root")" --import "$project_root" >/dev/null
    projects_json="$(superset projects list --local --json)"
    project_id="$(jq -r --arg path "$project_root" '.[] | select(.path == $path) | .id' <<<"$projects_json" | head -1)"
  fi
  [[ -n "$project_id" && "$project_id" != "null" ]] || {
    echo "Superset project registration could not be verified." >&2
    exit 1
  }

  branch_name="feat/$task_name"
  echo "Creating Superset task worktree: $branch_name (base: $base_branch)"
  superset ws create --local \
    --project "$project_id" \
    --name "$task_name" \
    --branch "$branch_name" \
    --base-branch "$base_branch" \
    --skip-branch-prefix

  cat <<EOF

Next: open the worktree path shown above, then run:
  opencode .

Implementation requests are automatically scope-routed. For a visible routing
report before work begins, use: /route-task <request>
EOF
}

# Prove a candidate config is safe to promote before it becomes the real one.
#
# V1 accepts an isolated config home, so OpenCode itself is the authority:
# point a throwaway config home at the candidate and list agents.
#
# V2 dropped `opencode agent list`, resolves configuration through its
# background service, and starts even with a malformed file, so no isolated
# load probe exists. There, prove what can be proven: the file parses as JSONC
# (best-effort; Bun's parser recovers from trailing junk), every agent is still
# registered, and every referenced prompt file resolves. The parse covers the
# rewrite's realistic failure modes — a doubled or dropped comma, an
# unbalanced brace. That is weaker than a real load, so the caller's message
# does not claim one.
validate_config() {
  local candidate="$1" probe_home rc=0 major
  if command -v opencode >/dev/null 2>&1; then
    probe_home="$(mktemp -d)"
    mkdir -p "$probe_home/opencode"
    cp "$candidate" "$probe_home/opencode/opencode.jsonc"
    # Agent prompts are referenced as {file:./agents/...} and must resolve.
    ln -s "$repo_root/opencode/agents" "$probe_home/opencode/agents"
    ln -s "$repo_root/opencode/commands" "$probe_home/opencode/commands"
    ln -s "$repo_root/opencode/skills" "$probe_home/opencode/skills"
    XDG_CONFIG_HOME="$probe_home" opencode agent list >/dev/null 2>&1 || rc=$?
    rm -rf "$probe_home"
    [[ $rc -eq 0 ]] && return 0
    major="$(opencode --version 2>/dev/null | grep -oE '[0-9]+' | head -1)"
    [[ "$major" == "1" ]] && return 1
  fi
  validate_config_v2 "$candidate"
}

validate_config_v2() {
  local candidate="$1" prompt_ref
  command -v bun >/dev/null 2>&1 || {
    echo "bun is required to validate a config on OpenCode v2." >&2
    return 1
  }
  bun -e 'try { Bun.JSONC.parse(require("fs").readFileSync(0, "utf8")); } catch { process.exit(1); }' < "$candidate" || return 1
  local agent
  for agent in explorer architect implementer quick-fix frontend backend database tester reviewer security-reviewer; do
    grep -q "\"$agent\": {" "$candidate" || return 1
  done
  while IFS= read -r prompt_ref; do
    [[ -f "$repo_root/opencode/${prompt_ref#./}" ]] || return 1
  done < <(sed -n 's/.*"prompt": "{file:\([^}]*\)}".*/\1/p' "$candidate")
  return 0
}

review_models() {
  local apply=false
  if [[ "${1:-}" == "--apply" ]]; then
    apply=true
    shift
  fi
  [[ $# -eq 0 ]] || { usage; exit 2; }

  local provider="opencode-go"
  local config_file="$repo_root/opencode/opencode.jsonc"
  local catalog cache_dir cache_file default_model configured_models unavailable_models new_models had_cache=false

  command -v opencode >/dev/null 2>&1 || {
    echo "OpenCode is required; run agentctl doctor." >&2
    exit 1
  }

  # --refresh pulls the catalog from models.dev rather than a local cache that
  # may be stale, so a configured model is never misreported as unavailable.
  if ! catalog="$(opencode models --refresh "$provider" 2>/dev/null | grep "^$provider/" | sort -u)" || [[ -z "$catalog" ]]; then
    echo "Could not load the $provider model catalog. Connect OpenCode Go, then retry." >&2
    exit 1
  fi

  default_model="$(sed -n 's/^[[:space:]]*"model": "\(opencode-go\/[^\"]*\)".*/\1/p' "$config_file" | head -1)"
  configured_models="$(sed -n 's/^[[:space:]]*"model": "\(opencode-go\/[^\"]*\)".*/\1/p' "$config_file" | sort -u)"
  unavailable_models=""
  while IFS= read -r model; do
    [[ -z "$model" ]] && continue
    if [[ $'\n'"$catalog"$'\n' != *$'\n'"$model"$'\n'* ]]; then
      unavailable_models+="  - $model\n"
    fi
  done <<<"$configured_models"

  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/agentctl"
  cache_file="$cache_dir/${provider}-models.txt"
  mkdir -p "$cache_dir"
  if [[ -f "$cache_file" ]]; then
    had_cache=true
    new_models="$(comm -13 <(sort "$cache_file") <(printf '%s\n' "$catalog" | sort))"
  else
    new_models=""
  fi
  printf '%s\n' "$catalog" | sort -u > "$cache_file"

  echo "OpenCode Go model review"
  echo "Catalog: $(printf '%s\n' "$catalog" | wc -l | tr -d ' ') models"
  echo "Configured default: ${default_model:-not found}"
  echo "Configured routing models:"
  printf '%s\n' "$configured_models" | sed 's/^/  - /'

  if [[ -n "$unavailable_models" ]]; then
    echo "WARNING: configured model(s) unavailable to this account:"
    printf '%b' "$unavailable_models"
  else
    echo "PASS: every configured routing model is available."
  fi

  if [[ -n "$new_models" ]]; then
    echo "New since the last review on this Mac:"
    printf '%s\n' "$new_models" | sed 's/^/  - /'
  elif [[ "$had_cache" == true ]]; then
    echo "No newly detected models since the previous review on this Mac."
  else
    echo "Baseline catalog recorded for future release comparisons."
  fi

  cat <<EOF

Suggested review brief (copy into an OpenCode planning session):
Review the OpenCode Go routing for a TypeScript, React, Next.js, Node.js,
Supabase/Postgres workflow. Current default: $default_model.
Current routing models:
$(printf '%s\n' "$configured_models" | sed 's/^/- /')

Compare current account-available models with the roles explorer, quick fix,
implementation, testing, architecture, code review, and security review. Recommend a change only
when it has a clear task-specific advantage. Preserve cost-efficient exploration
and testing, coding specialization for implementation, and stronger reasoning for
architecture/review. Return an exact proposed config diff and do not edit files.
EOF

  [[ "$apply" == true ]] || return 0
  [[ -t 0 ]] || { echo "--apply requires an interactive terminal." >&2; exit 1; }

  local explorer_model quick_fix_model implementation_model tester_model review_model selected_model confirmation temp_file role
  model_for_role() {
    sed -n "/\"$1\": {/,/^[[:space:]]*}/s/^[[:space:]]*\"model\": \"\(opencode-go\/[^\"]*\)\".*/\1/p" "$config_file" | head -1
  }
  explorer_model="$(model_for_role explorer)"
  quick_fix_model="$(model_for_role quick-fix)"
  implementation_model="$(model_for_role implementer)"
  tester_model="$(model_for_role tester)"
  review_model="$(model_for_role architect)"

  choose_model() {
    local label="$1" current="$2"
    while true; do
      read -r -p "$label [$current]: " selected_model
      selected_model="${selected_model:-$current}"
      if [[ $'\n'"$catalog"$'\n' == *$'\n'"$selected_model"$'\n'* ]]; then
        return 0
      fi
      echo "Not in the live $provider catalog: $selected_model" >&2
    done
  }

  echo
  echo "Choose only models already available to this account. Press Return to keep each current selection."
  choose_model "Default interactive coding" "$default_model"; default_model="$selected_model"
  choose_model "Explorer (low-cost context gathering)" "$explorer_model"; explorer_model="$selected_model"
  choose_model "Quick-fix (contained defects)" "$quick_fix_model"; quick_fix_model="$selected_model"
  choose_model "Implementation agents" "$implementation_model"; implementation_model="$selected_model"
  choose_model "Tester" "$tester_model"; tester_model="$selected_model"
  choose_model "Architecture/review/security agents" "$review_model"; review_model="$selected_model"

  cat <<EOF

Proposed routing:
  default: $default_model
  explorer: $explorer_model
  quick-fix: $quick_fix_model
  implementer, frontend, backend, database: $implementation_model
  tester: $tester_model
  architect, reviewer, security-reviewer: $review_model
EOF
  read -r -p "Apply this routing to opencode/opencode.jsonc? [y/N] " confirmation
  [[ "$confirmation" =~ ^[Yy]$ ]] || { echo "No changes applied."; return 0; }

  # Rewrite by matching the model line itself and preserving its exact
  # indentation and trailing comma. Emitting a hardcoded comma, as this
  # previously did, produces invalid JSONC whenever a "model" line is last in
  # its block; assuming fixed indent widths breaks on any reformat.
  # Tracking role by a known-name allowlist rather than by indentation width
  # keeps this correct regardless of formatting, and stops nested keys such as
  # "permission" or "bash" from being mistaken for an agent name.
  local indent comma replacement
  temp_file="$(mktemp "$config_file.XXXXXX")"
  role=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^[[:space:]]*\"(explorer|architect|implementer|quick-fix|frontend|backend|database|tester|reviewer|security-reviewer)\":[[:space:]]*\{ ]]; then
      role="${BASH_REMATCH[1]}"
    fi
    if [[ "$line" =~ ^([[:space:]]*)\"model\":[[:space:]]*\"opencode-go/[^\"]*\"(,?)[[:space:]]*$ ]]; then
      indent="${BASH_REMATCH[1]}"
      comma="${BASH_REMATCH[2]}"
      replacement=""
      case "$role" in
        # The top-level default is the only model line seen before any agent.
        "") replacement="$default_model" ;;
        explorer) replacement="$explorer_model" ;;
        quick-fix) replacement="$quick_fix_model" ;;
        implementer|frontend|backend|database) replacement="$implementation_model" ;;
        tester) replacement="$tester_model" ;;
        architect|reviewer|security-reviewer) replacement="$review_model" ;;
      esac
      [[ -n "$replacement" ]] && line="${indent}\"model\": \"${replacement}\"${comma}"
    fi
    printf '%s\n' "$line" >> "$temp_file"
  done < "$config_file"

  if ! validate_config "$temp_file"; then
    echo "The rewritten configuration failed validation; the original is untouched." >&2
    echo "Rejected candidate kept for inspection: $temp_file" >&2
    exit 1
  fi

  cp "$config_file" "$config_file.backup.$(date +%Y%m%d-%H%M%S)"
  mv "$temp_file" "$config_file"
  echo "Updated opencode/opencode.jsonc (validated before replacing the file)."
  echo "A timestamped backup is beside it. Review the diff, run 'agentctl sync', then commit this configuration checkpoint."
}

init_existing() {
  local target="${1:-.}"
  target="$(cd "$target" && pwd)"
  cd "$target"
  if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "Not a Git repository: $target" >&2
    exit 1
  fi
  cd "$(git rev-parse --show-toplevel)"
  require_clean_git "initialize"

  local manager
  manager="$(detect_package_manager)"
  echo "Repository: $PWD"
  echo "Package manager: $manager"
  echo "Top-level files: $(git ls-files | head -20 | tr '\n' ' ')"

  if [[ -f AGENTS.md ]]; then
    echo "Existing AGENTS.md preserved. Use /analyze-project then update it with verified project facts."
  else
    cp "$repo_root/templates/existing-project/AGENTS.md" AGENTS.md
    {
      printf '\n## Detected setup\n\n'
      printf -- '- Package manager: %s\n' "$manager"
      if [[ -f package.json ]]; then
        printf -- '- package.json scripts discovered; verify exact commands before use.\n'
      fi
      printf -- '- Initial record generated by agentctl; enrich with the analyze-project command or OpenCode init.\n'
    } >> AGENTS.md
    echo "Created a non-prescriptive AGENTS.md. Review and enrich it with repository evidence."
  fi
  echo "Next: open this repository in OpenCode and run /analyze-project before planning changes."
}

init_next() {
  local name="${1:-}"
  if [[ -z "$name" || "$name" == -* || "$name" == *'/'* ]]; then
    echo "Provide a simple new project directory name." >&2
    exit 1
  fi
  if [[ -e "$name" ]]; then
    echo "Target already exists: $name" >&2
    exit 1
  fi
  command -v pnpm >/dev/null 2>&1 || { echo "pnpm is required; run agentctl doctor." >&2; exit 1; }

  pnpm create next-app "$name" --ts --tailwind --eslint --app --src-dir --import-alias '@/*' --use-pnpm --yes
  cp "$repo_root/templates/new-next-supabase/AGENTS.md" "$name/AGENTS.md"
  mkdir -p "$name/docs"
  cp "$repo_root/templates/new-next-supabase/docs/architecture.md" "$name/docs/architecture.md"
  cp "$repo_root/templates/new-next-supabase/superset.config.json.example" "$name/superset.config.json.example"
  cp "$repo_root/templates/new-next-supabase/superset.config.local.json.example" "$name/superset.config.local.json.example"

  if command -v supabase >/dev/null 2>&1; then
    (cd "$name" && supabase init)
  else
    echo "Supabase CLI unavailable; run agentctl doctor, then run 'supabase init' inside $name."
  fi
  echo "Created $name without secrets. Complete docs/architecture.md before substantial implementation."
  echo "Review superset.config.json.example, then move it to .superset/config.json only after adapting setup/run and environment handling to this project."
}

command="${1:-}"
case "$command" in
  doctor) exec "$repo_root/scripts/doctor.sh" ;;
  check) exec "$repo_root/scripts/check.sh" ;;
  sync) exec "$repo_root/scripts/sync-config.sh" ;;
  unsync) exec "$repo_root/scripts/unsync-config.sh" ;;
  review-models) shift; review_models "$@" ;;
  start-task) shift; [[ $# -ge 1 && $# -le 2 ]] || { usage; exit 2; }; start_task "$1" "${2:-}" ;;
  init-existing) shift; init_existing "${1:-.}" ;;
  init-next) shift; init_next "${1:-}" ;;
  *) usage; exit 2 ;;
esac
